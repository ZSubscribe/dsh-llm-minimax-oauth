{
  "name": "dsh-llm-minimax-oauth",
  "description": "DeepSeek Harness plugin: MiniMax OAuth (Coding Plan) via browser login",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibam28/dsh-llm-minimax-oauth.git"
  },
  "bugs": {
    "url": "https://github.com/ibam28/dsh-llm-minimax-oauth/issues"
  },
  "homepage": "https://github.com/ibam28/dsh-llm-minimax-oauth#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-runtime/client"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "minimax",
    "oauth",
    "coding-plan",
    "anthropic",
    "ai",
    "llm",
    "browser-login",
    "device-code",
    "pkce"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.5"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.1.0"
  },
  "bin": {
    "dsh-minimax-login": "./bin/login.mjs"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.mts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "login": "node bin/login.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
